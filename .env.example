# Supabase (PostgreSQL)
# Get from: https://supabase.com → Project Settings → Database
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Resend (Email Alerts)
# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Cron Job Secret (any random string, set in Hostinger env vars)
CRON_SECRET="your-random-secret-here"

# Optional: Node environment
NODE_ENV="development"

# Manual trading signals (server only; do not put these in NEXT_PUBLIC variables)
SIGNALS_ACCESS_KEY=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
ALERT_FROM_EMAIL=""
APP_URL="https://vix-trading.de"

# Optional VIX real-time feed (server only)
# Massive Indices Advanced; I:VIX realtime entitlement required.
# Without a key, Yahoo remains visibly delayed and cannot authorize signal entries.
# With key present and provider unset, Massive is selected automatically.
MASSIVE_API_KEY=""
VIX_DATA_PROVIDER=""

# Website login (see docs/AUTH.md)
AUTH_EMAIL=""
AUTH_SESSION_SECRET=""
