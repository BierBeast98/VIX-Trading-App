// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Settings {
  id                 Int      @id @default(1)
  alertEmail         String   @default("")
  vixLowThreshold    Float    @default(14.5)
  vixHighThreshold   Float    @default(30.0)
  stdDevMultiplier   Float    @default(2.0)
  rollingWindowDays  Int      @default(30)
  targetReturnPct    Float    @default(18.0)
  trailingStopConfig Json     @default("{\"enabled\": true, \"stepPct\": 5}")
  riskBudget         Float    @default(10000)
  barrierWarningPct  Float    @default(10.0)
  spikeThresholdPct  Float    @default(15.0)
  vontobelIsin       String   @default("DE000VJ4MNF2")
  alertConfig        Json     @default("{}")
  updatedAt          DateTime @updatedAt
}

model Position {
  id             String   @id @default(cuid())
  certificateId  String
  name           String   @default("")
  entryVix       Float    @default(0)
  entryPrice     Float
  barrierLevel   Float
  currentBarrier Float
  leverageRatio  Float
  direction          String   @default("short")
  currentPrice       Float    @default(0)
  trailingStopFloor  Float?
  peakPnlPct         Float?
  status             String   @default("open")
  notes              String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  trades         Trade[]

  @@index([status])
}

model Trade {
  id             String    @id @default(cuid())
  positionId     String?
  position       Position? @relation(fields: [positionId], references: [id])
  certificateId  String
  direction      String    @default("short")
  entryDate      DateTime
  exitDate       DateTime?
  entryVix       Float    @default(0)
  exitVix        Float?
  barrierLevel   Float
  strikePrice    Float?
  leverageRatio  Float?
  ratio          Float?
  entryPrice     Float?
  exitPrice      Float?
  quantity       Int?
  returnPct      Float?
  holdDays       Int?
  alertTriggered Boolean   @default(false)
  notes          String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([entryDate])
  @@index([exitDate])
  @@index([positionId])
}

model AlertLog {
  id           String   @id @default(cuid())
  alertType    String
  message      String
  vixLevel     Float?
  urgency      String   @default("medium")
  dedupeKey    String?
  sentAt       DateTime @default(now())
  acknowledged Boolean  @default(false)

  @@index([sentAt])
  @@index([alertType])
}

// Arm/Re-Arm-Zustand pro Alert-Bedingung (key = dedupeKey, z.B. "profitTarget:DE000VY6F1Z4").
// AlertLog protokolliert nur Sendungen; hier steht, ob eine Bedingung gerade aktiv ist,
// damit Alerts nur beim Eintreten + max. 1x täglich als Erinnerung feuern.
model AlertState {
  key          String    @id
  active       Boolean   @default(false)
  since        DateTime  @default(now())
  lastFiredAt  DateTime?
  lastFiredDay String    @default("")
  updatedAt    DateTime  @updatedAt
}

model VixCache {
  id        String   @id @default("spot")
  data      Json
  updatedAt DateTime @updatedAt
}

model VixIntraday {
  id        String   @id @default(cuid())
  symbol    String   // "VIX" or "FUTURES"
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float    @default(0)

  @@unique([symbol, timestamp])
  @@index([symbol, timestamp])
}

// Append-only observations; exact duplicates are deduplicated by a content key.
model MarketObservation {
  id           BigInt   @id @default(autoincrement())
  key          String   @unique
  fetchId      String
  source       String
  instrument   String
  kind         String
  currency     String?
  isin         String?
  contract     String?
  sourceAt     DateTime?
  receivedAt   DateTime @default(now())
  quality      String
  last         Float?
  bid          Float?
  ask          Float?
  open         Float?
  high         Float?
  low          Float?
  close        Float?
  volume       Float?
  metadata     Json

  @@index([instrument, sourceAt])
  @@index([receivedAt])
  @@index([fetchId])
}

model MarketFetch {
  id             String   @id
  runId          String?
  source         String
  operation      String
  instrument     String
  origin         String
  measurement    String
  startedAt      DateTime
  finishedAt     DateTime
  durationMs     Int
  success        Boolean
  httpStatus     Int?
  responseBytes  Int?
  returnedPoints Int
  insertedPoints Int
  errorCode      String?

  @@index([startedAt])
  @@index([source, startedAt])
  @@index([runId])
}

model MarketCollectionRun {
  id          String   @id
  slot        String   @unique
  startedAt   DateTime
  finishedAt  DateTime?
  leaseUntil  DateTime
  status      String
  attempts    Int      @default(1)
  errorCode   String?

  @@index([startedAt])
}
